# Kopiera till .env och fyll i. Committa aldrig .env.
#
# All konfiguration går via environment variables, så samma applikation kan
# köras lokalt, på Oracle Cloud Free och senare hos Cleura utan kodändring.

# ── Databas ───────────────────────────────────────────────────────────────
POSTGRES_DB=skolinsyn
POSTGRES_USER=skolinsyn
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Applikationen använder denna. Peka om till en extern PostgreSQL i drift.
DATABASE_URL=postgresql://skolinsyn:@localhost:5432/skolinsyn

# PostgreSQL-tuning. Förvalen passar 6 GB RAM (Oracle Ampere A1).
# För AMD-microns 1 GB: 256MB / 512MB / 8MB / 128MB / 20.
PG_SHARED_BUFFERS=1536MB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=512MB
PG_MAX_CONNECTIONS=40

# ── Objektlagring (S3-kompatibel) ─────────────────────────────────────────
# Lokalt (MinIO via docker compose):
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=skolinsyn-dokument
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Cloudflare R2 i drift — samma applikation, bara andra värden:
#   S3_ENDPOINT=https://<konto-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=false
#
# Cleura eller annan svensk leverantör senare: byt endpoint och nycklar.
# Applikationen ska aldrig konstruera en URL till lagringen själv — den slår
# upp storage_key och låter lagringslagret signera.

# ── Utlämning av dokument ─────────────────────────────────────────────────
# Signerade URL:er i stället för att strömma filer genom applikationen. Detta
# är avgörande på en liten instans: 89 GB dokument får inte gå genom en vCPU.
DOCUMENT_URL_MODE=presigned
DOCUMENT_URL_TTL_SECONDS=900

# ── Laddning ──────────────────────────────────────────────────────────────
# Katalogen med exporten, monteras av 'load'-jobbet i docker-compose.
EXPORT_DIR=./export

# ── Arkivverktygen (körs på arbetsstation, inte på servern) ───────────────
SIRIS_ROOT=D:\siris
SIRIS_SOURCE=.
